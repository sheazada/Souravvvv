generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// NOTE:
/// - This schema is aligned to the Dairy Distributor ERP design.
/// - Some fields like partyType/partyId, referenceType/referenceId, entityType/entityId
///   are intentionally stored as scalar fields because Prisma does not support true
///   polymorphic relations.
/// - Core header/line and parent/child relations are modeled explicitly.

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  legalName   String?  @db.VarChar(200)
  gstin       String?  @db.VarChar(20)
  pan         String?  @db.VarChar(20)
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(150)
  logoUrl     String?
  timezone    String   @default("Asia/Kolkata") @db.VarChar(50)
  currencyCode String  @default("INR") @db.VarChar(10)
  addressJson Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model User {
  id                String      @id @default(uuid()) @db.Uuid
  organizationId    String      @db.Uuid
  fullName          String      @db.VarChar(150)
  mobile            String      @db.VarChar(20)
  email             String?     @db.VarChar(150)
  passwordHash      String?
  userType          String      @db.VarChar(50)
  employeeId        String?     @db.Uuid
  retailerId        String?     @db.Uuid
  preferredLanguage String?     @db.VarChar(10)
  isActive          Boolean     @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  userRoles                        UserRole[]
  sessions                         UserSession[]
  auditLogs                        AuditLog[]
  syncEvents                       SyncEvent[]
  notificationLogs                 NotificationLog[]        @relation("NotificationRecipient")
  retailerLedgerEntriesCreated     RetailerLedgerEntry[]    @relation("RetailerLedgerEntryCreatedBy")
  retailerPaymentIntentsCreated    RetailerPaymentIntent[]  @relation("RetailerPaymentIntentCreatedBy")
  retailerCreditOverridesApproved  RetailerCreditOverride[] @relation("RetailerCreditOverrideApprovedBy")

  @@unique([organizationId, mobile])
  @@index([organizationId, userType])
  @@index([organizationId, retailerId])
  @@index([organizationId, employeeId])
}

model Role {
  id            String           @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  code          String           @db.VarChar(50)
  name          String           @db.VarChar(100)
  description   String?
  isSystemRole  Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, code])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  module      String           @db.VarChar(50)
  action      String           @db.VarChar(50)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  deviceId         String?   @db.VarChar(100)
  ipAddress        String?
  refreshTokenHash String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId       String? @db.Uuid
  module       String  @db.VarChar(50)
  entityType   String  @db.VarChar(50)
  entityId     String? @db.Uuid
  action       String  @db.VarChar(50)
  beforeJson   Json?
  afterJson    Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, module, createdAt])
  @@index([organizationId, entityType, entityId])
}

model SystemSetting {
  id           String   @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  settingGroup String   @db.VarChar(50)
  settingKey   String   @db.VarChar(100)
  valueJson    Json
  isEncrypted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([organizationId, settingGroup, settingKey])
}

model Area {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(30)
  name           String   @db.VarChar(100)
  city           String?  @db.VarChar(100)
  state          String?  @db.VarChar(100)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
}

model Route {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  areaId            String?        @db.Uuid
  code              String         @db.VarChar(30)
  name              String         @db.VarChar(100)
  deliveryShift     String?        @db.VarChar(30)
  defaultCutoffTime String?        @db.VarChar(20)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  routeRetailers    RouteRetailer[]

  @@unique([organizationId, code])
  @@index([organizationId, areaId])
}

model RouteRetailer {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @db.Uuid
  routeId                String    @db.Uuid
  retailerId             String    @db.Uuid
  stopSequence           Int
  preferredDeliveryStart String?   @db.VarChar(20)
  preferredDeliveryEnd   String?   @db.VarChar(20)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  route    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@unique([routeId, retailerId])
  @@index([organizationId, routeId, stopSequence])
}

model Employee {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  employeeCode     String    @db.VarChar(30)
  fullName         String    @db.VarChar(150)
  designation      String?   @db.VarChar(100)
  mobile           String?   @db.VarChar(20)
  email            String?   @db.VarChar(150)
  joiningDate      DateTime? @db.Date
  aadhaarNo        String?   @db.VarChar(20)
  pan              String?   @db.VarChar(20)
  drivingLicenseNo String?   @db.VarChar(50)
  assignedRouteId  String?   @db.Uuid
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([organizationId, employeeCode])
  @@index([organizationId, assignedRouteId])
}

model Vehicle {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  vehicleNo        String    @db.VarChar(30)
  vehicleType      String?   @db.VarChar(50)
  capacityCrates   Int?
  capacityWeightKg Decimal?  @db.Decimal(10, 2)
  fuelType         String?   @db.VarChar(30)
  ownershipType    String?   @db.VarChar(30)
  driverEmployeeId String?   @db.Uuid
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([organizationId, vehicleNo])
}

model Supplier {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  supplierCode     String    @db.VarChar(30)
  name             String    @db.VarChar(150)
  contactPerson    String?   @db.VarChar(150)
  mobile           String?   @db.VarChar(20)
  email            String?   @db.VarChar(150)
  gstin            String?   @db.VarChar(20)
  pan              String?   @db.VarChar(20)
  addressJson      Json?
  paymentTermsDays Int?
  isActive         Boolean   @default(true)
  payableAccountId String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([organizationId, supplierCode])
  @@index([organizationId, name])
}

model Retailer {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @db.Uuid
  retailerCode           String             @db.VarChar(30)
  shopName               String             @db.VarChar(150)
  ownerName              String?            @db.VarChar(150)
  mobile                 String             @db.VarChar(20)
  alternateMobile        String?            @db.VarChar(20)
  email                  String?            @db.VarChar(150)
  addressLine1           String?            @db.VarChar(200)
  addressLine2           String?            @db.VarChar(200)
  locality               String?            @db.VarChar(100)
  city                   String?            @db.VarChar(100)
  state                  String?            @db.VarChar(100)
  pincode                String?            @db.VarChar(10)
  latitude               Decimal?           @db.Decimal(10, 7)
  longitude              Decimal?           @db.Decimal(10, 7)
  gstin                  String?            @db.VarChar(20)
  pan                    String?            @db.VarChar(20)
  aadhaarNo              String?            @db.VarChar(20)
  creditLimit            Decimal            @default(0) @db.Decimal(14, 2)
  creditDays             Int                @default(0)
  assignedRouteId        String?            @db.Uuid
  assignedSalespersonId  String?            @db.Uuid
  preferredDeliveryStart String?            @db.VarChar(20)
  preferredDeliveryEnd   String?            @db.VarChar(20)
  retailerCategory       String?            @db.VarChar(50)
  businessStatus         String             @default("active") @db.VarChar(30)
  shopPhotoUrl           String?
  orderingMode           String             @default("self_service") @db.VarChar(30)
  isOrderingEnabled      Boolean            @default(true)
  isBillingEnabled       Boolean            @default(true)
  receivableAccountId    String?            @db.Uuid
  openingBalance         Decimal            @default(0) @db.Decimal(14, 2)
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  routeMappings       RouteRetailer[]
  documents           RetailerDocument[]
  creditProfile       RetailerCreditProfile?
  ledgerEntries       RetailerLedgerEntry[]
  paymentIntents      RetailerPaymentIntent[]
  advanceWallet       RetailerAdvanceWallet?
  creditOverrides     RetailerCreditOverride[]
  paymentReminders    RetailerPaymentReminder[]
  paymentMetric       RetailerPaymentMetric?
  debitNotes          RetailerDebitNote[]
  creditNotes         CreditNote[]

  @@unique([organizationId, retailerCode])
  @@index([organizationId, shopName])
  @@index([organizationId, mobile])
  @@index([organizationId, assignedRouteId])
  @@index([organizationId, orderingMode])
}

model RetailerDocument {
  id            String    @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  retailerId    String    @db.Uuid
  documentType  String    @db.VarChar(50)
  fileUrl       String
  fileName      String    @db.VarChar(255)
  verifiedAt    DateTime?
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@index([organizationId, retailerId, documentType])
}

model Brand {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(100)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@unique([organizationId, name])
}

model ProductCategory {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  name           String            @db.VarChar(100)
  parentId       String?           @db.Uuid
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  parent   ProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("ProductCategoryHierarchy")
  products Product[]

  @@index([organizationId, parentId])
}

model Unit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(20)
  name           String   @db.VarChar(50)
  decimalPlaces  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productVariants ProductVariant[]

  @@unique([organizationId, code])
}

model TaxCode {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(30)
  hsnCode        String?  @db.VarChar(20)
  gstRate        Decimal  @default(0) @db.Decimal(5, 2)
  cgstRate       Decimal? @db.Decimal(5, 2)
  sgstRate       Decimal? @db.Decimal(5, 2)
  igstRate       Decimal? @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@unique([organizationId, code])
}

model CrateType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(30)
  name           String   @db.VarChar(100)
  capacityUnits  Int?
  depositValue   Decimal? @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  defaultProducts Product[] @relation("ProductDefaultCrateType")

  @@unique([organizationId, code])
}

model Product {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  productCode        String           @db.VarChar(30)
  name               String           @db.VarChar(150)
  brandId            String?          @db.Uuid
  categoryId         String?          @db.Uuid
  description        String?
  taxCodeId          String?          @db.Uuid
  isBatchTracked     Boolean          @default(false)
  isExpiryTracked    Boolean          @default(false)
  isReturnable       Boolean          @default(true)
  defaultCrateTypeId String?          @db.Uuid
  status             String           @default("active") @db.VarChar(20)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category         ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxCode          TaxCode?         @relation(fields: [taxCodeId], references: [id], onDelete: SetNull)
  defaultCrateType CrateType?       @relation("ProductDefaultCrateType", fields: [defaultCrateTypeId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]

  @@unique([organizationId, productCode])
  @@index([organizationId, name])
}

model ProductVariant {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @db.Uuid
  productId            String         @db.Uuid
  sku                  String         @db.VarChar(50)
  variantName          String?        @db.VarChar(100)
  sizeValue            Decimal?       @db.Decimal(10, 3)
  unitId               String?        @db.Uuid
  barcode              String?        @db.VarChar(100)
  mrp                  Decimal        @default(0) @db.Decimal(14, 2)
  distributorPrice     Decimal        @default(0) @db.Decimal(14, 2)
  defaultRetailerPrice Decimal        @default(0) @db.Decimal(14, 2)
  offerPrice           Decimal?       @db.Decimal(14, 2)
  weightKg             Decimal?       @db.Decimal(10, 3)
  volumeLtr            Decimal?       @db.Decimal(10, 3)
  status               String         @default("active") @db.VarChar(20)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit    Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  images  ProductImage[]

  @@unique([organizationId, sku])
  @@index([organizationId, barcode])
  @@index([organizationId, productId])
}

model ProductImage {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  variantId      String         @db.Uuid
  fileUrl        String
  sortOrder      Int            @default(0)
  isPrimary      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([organizationId, variantId])
}

model PriceBook {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  code           String                @db.VarChar(30)
  name           String                @db.VarChar(100)
  scopeType      String                @db.VarChar(30)
  priority       Int                   @default(0)
  validFrom      DateTime              @db.Date
  validTo        DateTime?             @db.Date
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  assignments PriceBookAssignment[]
  items       PriceBookItem[]

  @@unique([organizationId, code])
  @@index([organizationId, scopeType, isActive])
}

model PriceBookAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  priceBookId      String    @db.Uuid
  areaId           String?   @db.Uuid
  routeId          String?   @db.Uuid
  retailerId       String?   @db.Uuid
  retailerCategory String?   @db.VarChar(50)
  validFrom        DateTime  @db.Date
  validTo          DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)

  @@index([organizationId, priceBookId])
  @@index([organizationId, retailerId])
  @@index([organizationId, routeId])
}

model PriceBookItem {
  id           String    @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  priceBookId  String    @db.Uuid
  variantId    String    @db.Uuid
  basePrice    Decimal   @default(0) @db.Decimal(14, 2)
  offerPrice   Decimal?  @db.Decimal(14, 2)
  minQty       Decimal?  @db.Decimal(14, 3)
  maxQty       Decimal?  @db.Decimal(14, 3)
  validFrom    DateTime
  validTo      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)

  @@index([organizationId, priceBookId, variantId])
}

model Promotion {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @db.VarChar(30)
  name           String   @db.VarChar(150)
  promoType      String   @db.VarChar(30)
  conditionsJson Json?
  benefitsJson   Json?
  validFrom      DateTime
  validTo        DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, promoType, isActive])
}

model DeliveryCycle {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  cycleCode      String               @db.VarChar(30)
  orderDate      DateTime             @db.Date
  deliveryDate   DateTime             @db.Date
  deliveryShift  String               @db.VarChar(30)
  cutoffAt       DateTime
  status         String               @db.VarChar(30)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  salesOrders          SalesOrder[]
  demandConsolidations DemandConsolidation[]
  dispatchTrips        DispatchTrip[]

  @@unique([organizationId, cycleCode])
  @@index([organizationId, deliveryDate, deliveryShift])
}

model SalesOrder {
  id                   String                   @id @default(uuid()) @db.Uuid
  organizationId       String                   @db.Uuid
  orderNo              String                   @db.VarChar(30)
  retailerId           String                   @db.Uuid
  routeId              String?                  @db.Uuid
  deliveryCycleId      String                   @db.Uuid
  orderDate            DateTime
  requestedDeliveryDate DateTime?               @db.Date
  source               String                   @db.VarChar(30)
  orderingModeSnapshot String?                  @db.VarChar(30)
  enteredByUserId      String?                  @db.Uuid
  enteredByEmployeeId  String?                  @db.Uuid
  status               String                   @db.VarChar(30)
  subtotal             Decimal                  @default(0) @db.Decimal(14, 2)
  discountTotal        Decimal                  @default(0) @db.Decimal(14, 2)
  taxTotal             Decimal                  @default(0) @db.Decimal(14, 2)
  grandTotal           Decimal                  @default(0) @db.Decimal(14, 2)
  notes                String?
  approvedByUserId     String?                  @db.Uuid
  approvedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  deliveryCycle DeliveryCycle            @relation(fields: [deliveryCycleId], references: [id], onDelete: Restrict)
  items           SalesOrderItem[]
  statusHistory   SalesOrderStatusHistory[]
  demandSources   DemandSourceOrder[]
  creditOverrides RetailerCreditOverride[]

  @@unique([organizationId, orderNo])
  @@index([organizationId, retailerId, orderDate])
  @@index([organizationId, deliveryCycleId, status])
  @@index([organizationId, source])
}

model SalesOrderItem {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  salesOrderId    String    @db.Uuid
  variantId       String    @db.Uuid
  orderedQty      Decimal   @db.Decimal(14, 3)
  approvedQty     Decimal?  @db.Decimal(14, 3)
  unitPrice       Decimal   @db.Decimal(14, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(14, 2)
  taxRate         Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal   @default(0) @db.Decimal(14, 2)
  lineTotal       Decimal   @default(0) @db.Decimal(14, 2)
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId, variantId])
}

model SalesOrderStatusHistory {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  salesOrderId    String    @db.Uuid
  oldStatus       String?   @db.VarChar(30)
  newStatus       String    @db.VarChar(30)
  changedByUserId String?   @db.Uuid
  changedAt       DateTime  @default(now())
  note            String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([organizationId, salesOrderId, changedAt])
}

model DemandConsolidation {
  id               String                    @id @default(uuid()) @db.Uuid
  organizationId   String                    @db.Uuid
  consolidationNo  String                    @db.VarChar(30)
  deliveryCycleId  String                    @db.Uuid
  consolidationDate DateTime                 @db.Date
  status           String                    @db.VarChar(30)
  notes            String?
  createdByUserId  String?                   @db.Uuid
  approvedByUserId String?                   @db.Uuid
  approvedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  deliveryCycle DeliveryCycle              @relation(fields: [deliveryCycleId], references: [id], onDelete: Restrict)
  items         DemandConsolidationItem[]
  sourceOrders  DemandSourceOrder[]

  @@unique([organizationId, consolidationNo])
  @@index([organizationId, deliveryCycleId, status])
}

model DemandConsolidationItem {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @db.Uuid
  demandConsolidationId String   @db.Uuid
  variantId            String    @db.Uuid
  totalOrderQty        Decimal   @default(0) @db.Decimal(14, 3)
  totalApprovedQty     Decimal   @default(0) @db.Decimal(14, 3)
  bufferQty            Decimal   @default(0) @db.Decimal(14, 3)
  finalProcurementQty  Decimal   @default(0) @db.Decimal(14, 3)
  remarks              String?
