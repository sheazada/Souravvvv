{
  "name": "dairy-distributor-erp-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "(cd backend && npm install) && (cd frontend && npm install)",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "(cd backend && npm run build) && (cd frontend && npm run build)",
    "test": "npm run test:local:all",
    "test:backend:prisma": "bash ./scripts/run-backend-prisma-suites.sh",
    "test:backend:prisma:purchase-orders": "bash ./scripts/run-backend-prisma-suites.sh purchase-orders",
    "test:frontend:ui": "bash ./scripts/run-frontend-ui-suites.sh",
    "test:local:all": "bash ./scripts/run-all-local-checks.sh",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:seed": "npx tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}