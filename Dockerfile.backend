# Multi-stage production build for Dairy Distributor ERP API (NestJS + Prisma)
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root configurations and workspace module definitions
COPY package*.json ./
COPY prisma ./prisma
COPY backend/package*.json ./backend/

# Install dependencies cleanly
RUN npm ci

# Copy full backend codebase
COPY backend ./backend

# Generate Prisma client and compile NestJS bundle
RUN cd backend && npm run prisma:generate && npm run build

# Production runner stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Copy runtime dependencies and compiled artifacts from builder stage
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/backend/package*.json ./backend/
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/backend/node_modules ./backend/node_modules

EXPOSE 4000

# Run Prisma schema push / migrations and boot API server
CMD ["sh", "-c", "cd backend && npx prisma db push --schema ../prisma/schema.prisma && node dist/main.js"]
