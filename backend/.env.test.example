# Dedicated PostgreSQL database for Prisma-backed e2e tests
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dairy_erp_test

# Used by Razorpay webhook verification in tests
PAYMENT_GATEWAY_RAZORPAY_WEBHOOK_SECRET=test-razorpay-secret

# Cache TTL for retailer note threshold lookups (0 disables caching)
RETAILER_NOTE_THRESHOLD_CACHE_TTL_MS=60000

# Optional safety ceilings for retailer correction notes
RETAILER_CREDIT_NOTE_MAX_AMOUNT=1000000
RETAILER_CREDIT_NOTE_MAX_TAX_AMOUNT=1000000
RETAILER_CREDIT_NOTE_MAX_TOTAL_AMOUNT=1000000
RETAILER_DEBIT_NOTE_MAX_AMOUNT=1000000
